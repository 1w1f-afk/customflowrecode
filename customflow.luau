    local lower = string.lower
    local function hook(instance)
        if instance:IsA("TextLabel") or instance:IsA("TextButton") then
            local function apply()
                local current = instance.Text
                if current ~= lower(current) then instance.Text = lower(current) end
            end
            apply()
            instance:GetPropertyChangedSignal("Text"):Connect(apply)
        elseif instance:IsA("TextBox") then
            local function applyPlaceholder()
                local current = instance.PlaceholderText
                if current ~= lower(current) then instance.PlaceholderText = lower(current) end
            end
            applyPlaceholder()
            instance:GetPropertyChangedSignal("PlaceholderText"):Connect(applyPlaceholder)
        end
